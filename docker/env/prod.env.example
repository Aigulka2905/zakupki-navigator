# ── PROD окружение ─────────────────────────────────────────
# Скопируйте в docker/env/prod.env и заполните под целевой сервер.
#   cp docker/env/prod.env.example docker/env/prod.env

# ── Docker registry / тег образа ───────────────────────────
REGISTRY=registry.soderiz.ru
IMAGE_NAMESPACE=zakupki-ai
IMAGE_TAG=latest

# ── Сеть ───────────────────────────────────────────────────
# Внешний порт, на котором nginx слушает HTTP.
HTTP_PORT=80

# Куда nginx проксирует /api и /ws. Бэкенд развёрнут на ОТДЕЛЬНОМ сервере,
# поэтому здесь укажите его публичный адрес/домен (НЕ docker-сервис).
# nginx подставит этот host[:port] в Host-заголовок к бэкенду, а реальный
# домен фронта уйдёт в X-Forwarded-Host.
#   BACKEND_UPSTREAM=http://backend-host:3000
#   BACKEND_UPSTREAM=http://10.0.0.5:3000
BACKEND_UPSTREAM=http://backend-host:3000

# ── Сборка фронтенда ───────────────────────────────────────
# База API, зашиваемая в бандл на этапе build (относительный путь →
# тот же origin, что и nginx).
VITE_API_URL=/api
