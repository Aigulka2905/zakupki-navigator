# ── DEV окружение ──────────────────────────────────────────
# Скопируйте в docker/env/dev.env и при необходимости измените.
#   cp docker/env/dev.env.example docker/env/dev.env

# Куда nginx проксирует /api и /ws (docker-сервис backend).
BACKEND_UPSTREAM=http://backend:3000

# Куда nginx проксирует приложение (Vite dev-server).
FRONTEND_UPSTREAM=http://frontend:5173

# База API для фронтенда (относительный путь → тот же origin через nginx).
VITE_API_URL=/api

# Цель проксирования /api напрямую из Vite (доступ к :5173 минуя nginx).
VITE_PROXY_TARGET=http://backend:3000

# File-watching через polling (Docker Desktop / некоторые FS на Linux).
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true
