# ── PROD окружение (локальный запуск) ──────────────────────
# Бэкенд на том же хосте (localhost:8080). nginx резолвит upstream через
# Docker-resolver, который НЕ знает host.docker.internal (Linux), поэтому
# для локального теста указываем IP хост-шлюза docker0 напрямую.
# Для реального деплоя здесь будет домен/IP бэк-сервера.
BACKEND_UPSTREAM=http://172.17.0.1:8080

# Внешний порт фронт-nginx (8080 занят бэком, 8081 — dev-nginx).
HTTP_PORT=8082

# База API, зашиваемая в бандл (относительный путь → тот же origin).
VITE_API_URL=/api